index 77b5de8..b2d9b45 100644
--- a/src/tracee/tracee.c
+++ b/src/tracee/tracee.c
@@ -1,3 +1,5 @@
+#include <unistd.h>
+#include <stdio.h>
 /* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
  *
  * This file is part of PRoot.
@@ -53,6 +55,63 @@
 typedef LIST_HEAD(tracees, tracee) Tracees;
 static Tracees tracees;
 
+/* Inherited procfs uses the tracer's PID namespace. Every sandbox task is
+ * already tracked by PRoot; looking at unrelated host processes turns a
+ * /proc/self or numeric PID lookup into a host-wide scan. Read the live
+ * tracee records instead. A task's PID namespace is fixed at creation. Keep
+ * its mapping in that task's zero-initialized Tracee, never across lifetimes.
+ */
+pid_t get_namespace_pid(const Tracee *tracee, pid_t guest)
+{
+    char current_ns[64], candidate_ns[64], path[64], line[512];
+    ssize_t ns_len, other_len;
+    Tracee *candidate;
+
+    if (guest <= 0) return guest;
+    snprintf(path, sizeof(path), "/proc/%d/ns/pid", tracee->pid);
+    ns_len = readlink(path, current_ns, sizeof(current_ns));
+    if (ns_len < 0) return guest;
+
+    LIST_FOREACH(candidate, &tracees, link) {
+        pid_t inner = 0;
+        FILE *status;
+        if (candidate->pid <= 0 || candidate->terminated) continue;
+        if (candidate->namespace_pid.host != candidate->pid) {
+            snprintf(path, sizeof(path), "/proc/%d/ns/pid", candidate->pid);
+            other_len = readlink(path, candidate_ns, sizeof(candidate_ns));
+            if (other_len <= 0 || other_len >= (ssize_t)sizeof(candidate_ns)) continue;
+            snprintf(path, sizeof(path), "/proc/%d/status", candidate->pid);
+            status = fopen(path, "r");
+            if (!status) continue;
+            while (fgets(line, sizeof(line), status)) {
+                if (!strncmp(line, "NSpid:", 6)) {
+                    char *cursor = line + 6, *end;
+                    while (*cursor) {
+                        long value = strtol(cursor, &end, 10);
+                        if (cursor == end) break;
+                        inner = (pid_t)value;
+                        cursor = end;
+                    }
+                    break;
+                }
+            }
+            fclose(status);
+            if (inner <= 0) continue;
+            memcpy(candidate->namespace_pid.name, candidate_ns, other_len);
+            candidate->namespace_pid.length = other_len;
+            candidate->namespace_pid.guest = inner;
+            /* Also invalidate if PRoot assigns a different host PID. */
+            candidate->namespace_pid.host = candidate->pid;
+        }
+        if (candidate->namespace_pid.guest == guest
+            && candidate->namespace_pid.length == ns_len
+            && !memcmp(current_ns, candidate->namespace_pid.name, ns_len))
+            return candidate->pid;
+    }
+    return guest;
+}
+
