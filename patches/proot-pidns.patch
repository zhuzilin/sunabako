+/* Optional Sunabako ABI-1 helper. Each socket ends in an unprivileged,
+ * capability-free chroot containing exactly one writable filesystem mapping.
+ * No copying fallback: rename keeps the kernel's atomicity and error semantics.
+ */
+static int sunabako_socket_io(int fd, void *buffer, size_t length, bool sending)
+{
+    char *cursor = buffer;
+    while (length) {
+        ssize_t n = sending ? send(fd, cursor, length, MSG_NOSIGNAL) : recv(fd, cursor, length, 0);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return -EIO;
+        cursor += n; length -= n;
+    }
+    return 0;
+}
+
+static int sunabako_refer(Tracee *tracee, word_t call)
+{
+    const char *mapping = getenv("SUNABAKO_RENAME_HELPERS"), *row;
+    char old_path[PATH_MAX], new_path[PATH_MAX];
+    bool simple = call == PR_rename || call == PR_link;
+    bool link_op = call == PR_link || call == PR_linkat;
+    int fd = -1, error, status;
+    size_t prefix = 0;
+    uint32_t header[4];
+    if (!mapping) return -EXDEV;
+    if (call == PR_linkat && peek_reg(tracee, ORIGINAL, SYSARG_5) != 0) return -EXDEV;
+    status = read_path(tracee, old_path, peek_reg(tracee, MODIFIED, simple ? SYSARG_1 : SYSARG_2));
+    if (status < 0) return status;
+    status = read_path(tracee, new_path, peek_reg(tracee, MODIFIED, simple ? SYSARG_2 : SYSARG_4));
+    if (status < 0) return status;
+    for (row = mapping; *row;) {
+        char *tab;
+        long candidate = strtol(row, &tab, 10);
+        const char *end = strchr(tab, '\n');
+        if (*tab != '\t' || !end || candidate < 3 || candidate > 1023) break;
+        size_t n = end - (tab + 1);
+        if (n > prefix && strlen(old_path) > n && strlen(new_path) > n
+            && !strncmp(old_path, tab + 1, n) && old_path[n] == '/'
+            && !strncmp(new_path, tab + 1, n) && new_path[n] == '/') {
+            prefix = n; fd = (int)candidate;
+        }
+        row = end + 1;
+    }
+    if (fd < 0) return -EXDEV;
+    header[0] = link_op ? 2 : 1;
+    header[1] = call == PR_renameat2 ? peek_reg(tracee, ORIGINAL, SYSARG_5) : 0;
+    header[2] = strlen(old_path + prefix);
+    header[3] = strlen(new_path + prefix);
+    if (sunabako_socket_io(fd, header, sizeof(header), true)
+        || sunabako_socket_io(fd, old_path + prefix, header[2], true)
+        || sunabako_socket_io(fd, new_path + prefix, header[3], true)
+        || sunabako_socket_io(fd, &error, sizeof(error), false)) return -EIO;
+    return -error;
+}
