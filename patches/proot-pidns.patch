 /**
  * Remove @zombie from its parent's list of zombies.  Note: this is a
@@ -347,6 +406,35 @@ Tracee *get_tracee(const Tracee *current_tracee, pid_t pid, bool create)
     return (create ? new_tracee(pid) : NULL);
 }
 
+/* Preserve the execing thread's loader state when Linux replaces its TID
+ * with the thread-group leader's PID. Guest ptrace is disabled in Sunabako;
+ * leave emulated-tracer relationships outside this supported path unchanged.
+ */
+void rekey_exec_tracee(pid_t pid, pid_t former_pid)
+{
+    Tracee *execer = get_tracee(NULL, former_pid, false);
+    Tracee *leader = get_tracee(NULL, pid, false);
+    Tracee *relative;
+
+    if (execer == NULL || execer->as_ptracee.ptracer != NULL
+        || execer->as_ptracer.nb_ptracees != 0
+        || (leader != NULL && (leader->as_ptracee.ptracer != NULL
+                               || leader->as_ptracer.nb_ptracees != 0)))
+        return;
+    if (leader != NULL) {
+        execer->parent = leader->parent;
+        execer->killall_on_exit |= leader->killall_on_exit;
+        LIST_FOREACH(relative, &tracees, link) {
+            if (relative->parent == leader) relative->parent = execer;
+        }
+        leader->killall_on_exit = false;
+        leader->pid = former_pid;
+        terminate_tracee(leader);
+    }
+    execer->clone = false;
+    execer->pid = pid;
+}
+
