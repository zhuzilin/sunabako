 #include <stdlib.h>		/* atoi(3), strtol(3), */
 #include <errno.h>		/* E*, */
 #include <assert.h>		/* assert(3), */
+#include <dirent.h>
+#include <unistd.h>
 
 #include "path/proc.h"
 #include "tracee/tracee.h"
 #include "path/path.h"
 #include "path/binding.h"
 
+/* Sunabako: inherited procfs names processes in the tracer's PID namespace.
+ * Translate guest numeric PIDs/TIDs only among tasks in the tracee's namespace.
+ * No cached PID mapping: a recycled PID must never resolve to another task.
+ */
+static pid_t sunabako_proc_pid(const Tracee *tracee, pid_t guest, bool threads)
+{
+    char directory[64], current_ns[64], candidate_ns[64], path[128], line[512];
+    struct dirent *entry;
+    DIR *dir;
+    ssize_t ns_len, other_len;
+    pid_t answer = guest;
+    snprintf(path, sizeof(path), "/proc/%d/ns/pid", tracee->pid);
+    ns_len = readlink(path, current_ns, sizeof(current_ns));
+    if (ns_len < 0) return guest;
+    if (threads) snprintf(directory, sizeof(directory), "/proc/%d/task", tracee->pid);
+    else strcpy(directory, "/proc");
+    dir = opendir(directory);
+    if (!dir) return guest;
+    while ((entry = readdir(dir)) != NULL) {
+        pid_t host = atoi(entry->d_name), inner = 0;
+        if (host <= 0) continue;
+        snprintf(path, sizeof(path), "%s/%d/ns/pid", directory, host);
+        other_len = readlink(path, candidate_ns, sizeof(candidate_ns));
+        if (other_len != ns_len || memcmp(current_ns, candidate_ns, ns_len)) continue;
+        snprintf(path, sizeof(path), "%s/%d/status", directory, host);
+        FILE *f = fopen(path, "r");
+        if (!f) continue;
+        while (fgets(line, sizeof(line), f)) {
+            if (!strncmp(line, "NSpid:", 6)) {
+                char *cursor = line + 6, *end;
+                while (*cursor) {
+                    long value = strtol(cursor, &end, 10);
+                    if (cursor == end) break;
+                    inner = (pid_t)value; cursor = end;
+                }
+                break;
+            }
+        }
+        fclose(f);
+        if (inner == guest) { answer = host; break; }
+    }
+    closedir(dir);
+    return answer;
+}
